_SHOWN = {
    "id", "name", "context_length", "max_output_tokens", "credits",
    "supports_images", "supports_tool_call", "supports_reasoning", "only_reasoning",
    "reasoning_supported_efforts", "reasoning_default_effort", "reasoning_effort", "reasoning_summary",
    "object", "owned_by", "created",  # 协议样板（上游常量）
}


def cmd_models(args):
    """模型清单。默认打表格（列与 Web 面板一致）；--more 逐模型打完整字段。"""
    realm = None
    more = "--more" in args
    if "--realm" in args:
        i = args.index("--realm")
        if i + 1 >= len(args):
            fail("用法: wbapi models [--realm cn|global] [--more]")
        realm = args[i + 1]
    st, d = req("/v1/models", gw_token(), timeout=30)
    if st != 200:
        fail(f"拉模型列表失败：{err_msg(d)}")
    ms = d.get("data") or []
    if realm:
        ms = [m for m in ms if m["id"].startswith(realm + ":")]
    if not ms:
        print("模型列表是空的：网关要至少一个可用账号才能拉到上游模型表（看 wbapi status）")
        return
    if more:
        return print_models_more(ms)

    W_NAME, W_ID, W_REALM, W_RATE, W_CAP, W_CTX, W_OUT = 24, 30, 4, 7, 4, 11, 12
    head = (
        f"  {pad('模型', W_NAME)} {pad('ID', W_ID)} {pad('域', W_REALM)} "
        f"{pad('积分倍率', W_RATE)} {pad('能力', W_CAP)} "
        f"{pad('上下文长度', W_CTX, True)} {pad('单次最大输出', W_OUT, True)}"
    )
    print(f"模型（{len(ms)} 个{'，域 ' + realm if realm else ''}）:")
    print(head)
    print("  " + "─" * (dwidth(head) - 2))
    for m in ms:
        rate = credit_rate(m) or "—"
        vision = "识图" if m.get("supports_images") else "文字"
        ctx = f"{m.get('context_length') or 0:,}"
        out = f"{m['max_output_tokens']:,}" if m.get("max_output_tokens") else "—"
        print(
            f"  {pad(model_name(m), W_NAME)} {pad(m['id'], W_ID)} {pad(realm_text(m['id']), W_REALM)} "
            f"{pad(rate, W_RATE)} {pad(vision, W_CAP)} {pad(ctx, W_CTX, True)} {pad(out, W_OUT, True)}"
        )
    print("\n  --more 看推理档位与全部字段；--realm cn|global 只看某个域。")


def print_models_more(ms):
    """--more：逐模型纵向打印完整字段（对应 Web 面板的「更多」弹窗）。"""
    print(f"模型完整信息（{len(ms)} 个）:\n")
    for m in ms:
        print(f"{m['id']} — {model_name(m)}")
        rows = [
            ("域", realm_text(m["id"])),
            ("积分倍率", credit_rate(m) or "上游未给"),
            ("上下文长度", f"{m.get('context_length') or 0:,}"),
            ("单次最大输出", f"{m['max_output_tokens']:,}" if m.get("max_output_tokens") else "—"),
            ("可传推理档位", " / ".join(m["reasoning_supported_efforts"]) if m.get("reasoning_supported_efforts") else "无档位"),
            ("默认档位", m.get("reasoning_default_effort") or "—"),
            ("上游默认 effort", m.get("reasoning_effort") or "—"),
            ("思考摘要", m.get("reasoning_summary") or "—"),
        ]
        for key, label, _ in CAPS:
            rows.append((label, "是" if m.get(key) else "否"))
        for k in sorted(m):
            if k in _SHOWN:
                continue
            v = m[k]
            if v in (None, "", [], False):
                continue
            if isinstance(v, list):
                rows.append((k, ", ".join(map(str, v))))
            elif isinstance(v, bool):
                rows.append((k, "是"))
            else:
                rows.append((k, str(v)))
        w = max(dwidth(r[0]) for r in rows)
        for k, v in rows:
            print(f"  {pad(k, w)}  {v}")
        print()

def cmd_stats(args):
    if "--reset" in args:
        st, d = admin_ok("/stats/reset", "POST")
        if st != 200:
            fail(f"清零失败：{err_msg(d)}")
        print("[✓] 统计已清零（从此刻重新累计）")
        return
    st, d = req("/v1/stats", gw_token(), timeout=30)
    if st != 200:
        fail(f"读取统计失败：{err_msg(d)}")
    if not d.get("enabled", True):
        print(f"统计未启用：{d.get('message') or ''}")
        return
    t = d.get("total") or {}
    print(f"统计窗口: {ts(d.get('since'))} 起，已运行 {fmt_secs(d.get('uptime_sec'))}\n")
    print(f"  总计   请求 {t.get('requests', 0)}（成功 {t.get('success', 0)} / 失败 {t.get('failed', 0)}）"
          f"  token {t.get('total_tokens', 0)}")
    print(f"         平均首字 {t.get('avg_ttfb_ms', 0):.0f}ms  平均耗时 {t.get('avg_latency_ms', 0):.0f}ms"
          f"  速率 {t.get('tokens_per_sec', 0):.1f}tok/s  缓存命中率 {100 * t.get('cache_hit_rate', 0):.0f}%")
    for m in (d.get("models") or [])[:12]:
        print(f"  {m['model']:<28} 请求 {m['requests']:>5}  失败 {m['failed']:>4}  "
              f"首字 {m.get('avg_ttfb_ms', 0):>6.0f}ms  token {m.get('total_tokens', 0):>8}")


