def cmd_config():
    st, d = req("/api/admin/config", admin_token())
    if st == 200:
        cfg = d.get("config") or {}
    else:
        cfg = redact_local(CFG)
    print(json.dumps(cfg, indent=2, ensure_ascii=False))


def redact_local(cfg):
    """离线兜底：本地 config.json 脱敏后展示（不打印任何密钥明文）。"""
    out = json.loads(json.dumps(cfg))
    for k in ("api_key",):
        if out.get(k):
            out[k] = "***"
    if isinstance(out.get("upstash"), dict):
        for k in ("url", "token"):
            if out["upstash"].get(k):
                out["upstash"][k] = "***"
    if isinstance(out.get("admin"), dict) and out["admin"].get("token"):
        out["admin"]["token"] = "***"
    for k in ("device_token",):
        if isinstance(out.get("upstream"), dict) and out["upstream"].get(k):
            out["upstream"][k] = "***"
    return out


# --------------------------------------------------------------------------- 服务

def cmd_log(n=30):
    if IS_WIN:
        # Windows：journalctl 不存在，读项目根日志（Go 的 log 默认走 stderr）
        for name in ("gateway.err.log", "gateway.log"):
            path = os.path.join(PROJECT, name)
            try:
                with open(path, encoding="utf-8", errors="replace") as f:
                    lines = f.readlines()
                if lines:
                    print("".join(lines[-n:]), end="")
                    return
            except FileNotFoundError:
                continue
        print(f"（{PROJECT} 下没有网关日志文件）")
        return
    print(sh("journalctl", "-u", GATEWAY_SVC, "-n", str(n), "--no-pager").stdout)


def cmd_svc(action):
    if IS_WIN:
        # 计划任务版：start=Start-ScheduledTask，stop=结束进程，restart=先停后起
        for svc, proc in ((GATEWAY_SVC, "server.exe"), (TUNNEL_SVC, "cloudflared.exe")):
            if action == "start":
                r = sh("schtasks", "/Run", "/TN", svc)
                ok = r.returncode == 0
            elif action == "stop":
                r = sh("taskkill", "/F", "/IM", proc)
                ok = r.returncode == 0
            else:  # restart
                sh("taskkill", "/F", "/IM", proc)
                import time as _t
                _t.sleep(2)
                r = sh("schtasks", "/Run", "/TN", svc)
                ok = r.returncode == 0
            print(f"{action} {svc}: {'[✓] 完成' if ok else '[!] 失败：' + (r.stderr or r.stdout or '').strip()}")
        return
    for svc in (GATEWAY_SVC, TUNNEL_SVC):
        print(f"{action} {svc}: {systemctl(action, svc) or 'ok'}")


def cmd_tunnel(args):
    sub = args[0] if args else "status"
    if sub == "status":
        print("隧道:", systemctl("is-active", TUNNEL_SVC), f"(https://{PUBLIC_HOST})")
        return
    if IS_WIN:
        if sub == "stop":
            r = sh("taskkill", "/F", "/IM", "cloudflared.exe")
            print(f"stop {TUNNEL_SVC}: {'[✓] 完成' if r.returncode == 0 else '[!] 未在运行'}")
            return
        if sub == "start":
            r = sh("schtasks", "/Run", "/TN", TUNNEL_SVC)
            print(f"start {TUNNEL_SVC}: {'[✓] 完成' if r.returncode == 0 else '[!] 失败：' + (r.stderr or r.stdout or '').strip()}")
            return
        if sub == "restart":
            sh("taskkill", "/F", "/IM", "cloudflared.exe")
            import time as _t
            _t.sleep(2)
            r = sh("schtasks", "/Run", "/TN", TUNNEL_SVC)
            print(f"restart {TUNNEL_SVC}: {'[✓] 完成' if r.returncode == 0 else '[!] 失败：' + (r.stderr or r.stdout or '').strip()}")
            return
    print(systemctl(sub, TUNNEL_SVC) or f"[✓] {sub} 完成")


# --------------------------------------------------------------------------- 自检

def cmd_doctor():
    """一键体检：把"看起来在跑但其实不工作"的常见原因逐条查出来。

    起因：auths/ 被 chown 给别的 uid 后，网关进程读不到 0600 的凭证文件 → 池子
    0 个账号、模型列表空、面板空白，但服务状态仍是 active，肉眼很难定位。
    """
    try:
        import pwd
    except ImportError:
        pwd = None  # Windows：没有 uid/属主概念，跳过相关检查

    problems = []
    ok = []

    def check(cond, ok_msg, bad_msg):
        (ok if cond else problems).append(ok_msg if cond else bad_msg)

    # 1) unit 与二进制
    if IS_WIN:
        # Windows：服务=计划任务，二进制=项目根的 server.exe
        exe = os.path.join(PROJECT, "server.exe")
        task = sh("schtasks", "/Query", "/TN", GATEWAY_SVC)
        check(task.returncode == 0, "计划任务已注册（wbapi-gateway）", "计划任务 wbapi-gateway 未注册（开机自启失效）")
        check(os.path.exists(exe), f"二进制存在：{exe}", "server.exe 不存在（先 go build -o server.exe ./cmd/server）")
    else:
        unit_user = systemctl("show", "-p", "User", "--value", GATEWAY_SVC).strip() or "root"
        # ExecStart 要从 unit 文件里读：systemctl show --value 给的是 { path=... ; argv[]=... } 结构
        frag = systemctl("show", "-p", "FragmentPath", "--value", GATEWAY_SVC).strip()
        unit_exec = ""
        if frag and os.path.exists(frag):
            with open(frag) as f:
                for line in f:
                    if line.startswith("ExecStart="):
                        unit_exec = line.split("=", 1)[1].strip()
                        break
        check(bool(unit_exec), f"unit 已加载（User={unit_user}）", f"{GATEWAY_SVC} 未加载（systemd 里没有这个服务？）")
        exe = unit_exec.split()[0] if unit_exec else ""
        check(os.path.exists(exe), f"二进制存在：{exe}", f"unit 指向的二进制不存在：{exe}")

    # 2) auths 属主/可读性 —— 本次事故的根因
    auth_dir = CFG.get("auth_dir") or "./auths"
    if not os.path.isabs(auth_dir):
        auth_dir = os.path.join(os.path.dirname(os.path.realpath(CONFIG_PATH)), auth_dir)
    auth_dir = os.path.normpath(auth_dir)
    try:
        want = pwd.getpwnam(unit_user).pw_uid if pwd else None
    except KeyError:
        want = None
    files = [f for f in sorted(os.listdir(auth_dir)) if f.endswith(".json")] if os.path.isdir(auth_dir) else []
    check(bool(files), f"凭证文件 {len(files)} 个（{auth_dir}）", f"{auth_dir} 里没有 .json 凭证（先跑 ./login.sh 登录）")
    if files and want is not None:
        bad = [f for f in files if os.stat(os.path.join(auth_dir, f)).st_uid != want]
        check(not bad,
              f"auths 属主与网关用户（{unit_user}）一致",
              f"auths 里有 {len(bad)} 个文件属主不是 {unit_user}（uid={want}）→ 网关读不到，池子会是 0：\n"
              f"        sudo chown -R {unit_user}:{unit_user} {auth_dir}")
        unreadable = [f for f in files if not os.access(os.path.join(auth_dir, f), os.R_OK)]
        check(not unreadable, "凭证文件当前用户可读", f"当前用户读不到 {len(unreadable)} 个凭证文件")

    # 3) keys.json 权限（含明文调用 key）
    kp = keys_path()
    if os.path.exists(kp):
        mode = oct(os.stat(kp).st_mode & 0o777)
        if IS_WIN:
            ok.append("keys.json 存在（Windows 下不检查权限位）")
        else:
            check(mode in ("0o600", "0o400"), f"keys.json 权限 {mode}", f"keys.json 权限 {mode}（建议 600：内含明文调用 key）")
    else:
        ok.append("keys.json 不存在（网关不鉴权）")

    # 4) 管理面前置条件（上游 fail-fast 与面板依赖）
    admin_enabled = (CFG.get("admin") or {}).get("enabled")
    check(bool(admin_enabled), "admin.enabled=true", "admin.enabled 未开：面板与 /admin/* 端点都不会注册")
    if admin_enabled:
        check(bool(CFG.get("api_key")), "api_key 非空（admin.enabled 的前置）", "admin.enabled=true 但 api_key 为空 → 网关会拒绝启动")

    # 5) 运行态
    if systemctl("is-active", GATEWAY_SVC) == "active":
        st, h = req("/healthz", "", timeout=5)
        if st == 200:
            total, healthy = h.get("total", 0), h.get("healthy", 0)
            check(healthy > 0, f"可接活账号 {healthy}/{total}", f"账号总数 {total}，可接活 {healthy} → 看上面的 auths 属主检查")
            realms = [k for k, v in (h.get("realm_servable") or {}).items() if v]
            ok.append("可接活域: " + (",".join(realms) or "无"))
        else:
            problems.append(f"/healthz 异常（HTTP {st}）：{err_msg(h)}")
    else:
        problems.append(f"{GATEWAY_SVC} 未运行（sudo systemctl start {GATEWAY_SVC}）")
    check(systemctl("is-active", TUNNEL_SVC) == "active", f"{TUNNEL_SVC} 运行中", f"{TUNNEL_SVC} 未运行（公网不可达）")

    for line in ok:
        print(f"  ✓ {line}")
    for line in problems:
        print(f"  ✗ {line}")
    print(f"\n{len(ok)} 项正常，{len(problems)} 项待处理" + ("（都有可执行的修复命令）" if problems else ""))
    return 1 if problems else 0


# --------------------------------------------------------------------------- 入口

def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "status"
    rest = a[1:]
    if cmd in ("status", "check"):
        cmd_status()
    elif cmd == "accounts":
        cmd_accounts()
    elif cmd in ("quota", "pool"):
        cmd_quota(rest)
    elif cmd in ("acct", "account"):
        cmd_acct(rest)
    elif cmd == "task":
        cmd_task(rest)
    elif cmd in ("models", "list"):
        cmd_models(rest)
    elif cmd == "stats":
        cmd_stats(rest)
    elif cmd == "panel":
        cmd_panel()
    elif cmd == "config":
        cmd_config()
    elif cmd in ("doctor", "check-up"):
        sys.exit(cmd_doctor())
    elif cmd == "key":
        sub = rest[0] if rest else "list"
        if sub == "list":
            cmd_key_list("--show" in a)
        elif sub == "new":
            cmd_key_new(rest[1] if len(rest) > 1 else "")
        elif sub in ("revoke", "rm", "delete"):
            if len(rest) < 2:
                fail("用法: wbapi key revoke <前缀>")
            cmd_key_revoke(rest[1])
        else:
            print(__doc__)
    elif cmd == "log":
        cmd_log(int(rest[0]) if rest else 30)
    elif cmd in ("start", "stop", "restart"):
        cmd_svc(cmd)
    elif cmd == "tunnel":
        cmd_tunnel(rest)
    elif cmd in ("help", "-h", "--help"):
        print(__doc__)
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
